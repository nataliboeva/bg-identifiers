<Project>

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>

  <PropertyGroup Label="Shared metadata">
    <Authors>Natali Boeva</Authors>
    <Copyright>Copyright (c) 2026 Natali Boeva</Copyright>
    <RepositoryUrl>https://github.com/nataliboeva/bg-identifiers</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

</Project>
